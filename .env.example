# App settings seeded into the Mongo `settings` doc on first provisioning only
# ($setOnInsert — changing these after the first boot has no effect; edit in the
# Settings UI instead). Distinct from the infra config in config.json.
# Host directory for composed .m3u + XMLTV guide exports (bind-mounted to
# /app/compose) so they survive a container rebuild. Must be writable by the
# container's `node` user (uid 1000): e.g.
#   mkdir -p </absolute/path/> && sudo chown -R 1000:1000 </absolute/path/>
# BACKUPS_PATH is the analogous host directory for scheduled backups (bind-mounted
# to /backups, the settings.backupLocation default) — same uid-1000 writability
# caveat as COMPOSE_PATH; defaults to ./backups if left unset.
# ------------------------------------------------------------------------------------------

MASQUERADARR_PORT=3000
DISPLAY_NAME=masqueradarr
DOMAIN=http://localhost:3000

COMPOSE_PATH=/absolute/path/to/masqueradarr-vols/compose
BACKUPS_PATH=/absolute/path/to/masqueradarr-vols/backups
APP_USER_ID=1000
APP_GROUP_ID=1000
TZ=America/New_York

# EDGE-3 (opt-in, off by default). Leave UNSET for today's topology: Node is the public edge and the Rust
# video data plane runs as a loopback sidecar behind it. Set MASQ_EDGE=1 to INVERT it — the Rust proxy binds
# the public port (still MASQUERADARR_PORT → :3000) and reverse-proxies the SPA / API / WebSockets to Node on
# a loopback internal port (8080). Same public port, same DOMAIN, no other config change; clear it to revert.
#
# You flip it when you want Node's single-threaded event loop out of the video byte path. Everything else is 
# a consequence of that.
# Use Cases:
# (1) Many concurrent viewers / high-bitrate channels. This is the main one. Node's one event loop is the  
# ceiling in sidecar mode; once you're shoveling dozens of streams (or a few 4K/high-bitrate ones), the loop 
# saturates on byte-piping and starts adding jitter to everything, including the very dashboard you're  
# watching it on. Rust (multi-threaded tokio, async, near-zero-copy) shovels bytes far better and won't starve  
# the control plane. If viewership is growing, this is the flip.
# (2) Keeping the management UI responsive under streaming load. Corollary of the above: in sidecar mode a 
# streaming burst can make the Dashboard / Active Streams WS / logs feel sluggish (shared loop). Edge frees 
# Node's loop, so the UI stays snappy no matter how much video is flowing.
# (3) Constrained hardware (Pi / small VPS). Sidecar mode double-handles every byte (Rust→its response→Node's 
# fetch→Node→client = twice the copies + Node Buffer churn). Edge halves that. On a small box, the same hardware 
# serves noticeably more streams. The Rust crate is explicitly tuned for "runs 24/7 on modest hardware," and 
# this is where that pays off.
# (4) Lowest-latency / most-durable byte path. The durability engine (retry, mirror-failover, stall detection, 
# the bounded read-ahead buffer, raw-TS) already lives in Rust in both modes — but in sidecar mode its output 
# still passes through Node's pipe, an extra buffering/backpressure surface between Rust and the client. Edge 
# applies Rust's backpressure directly to the client socket. For a public-facing deployment serving real users, 
# that's the tightest path.
# (5) When to stay on the default (honest counterpoint): a personal/small setup with a handful of viewers gets 
# zero benefit — Node's loop isn't stressed, and sidecar mode is the simpler, more battle-tested path. Edge also 
# relaxes token-revocation from Express's strict per-hop check to a ~30s TTL window, and it's the 
# higher-blast-radius topology (Rust becomes critical-path for all traffic, not just streaming) — plus it still 
# needs the live-stack E2E pass before I'd call it production-proven. So: flip it for scale, hardware pressure, 
# or a hardened public deployment; leave it off otherwise.
# ------------------------------------------------------------------------------------------

MASQ_EDGE=1

# Outbound-fetch DNS nameserver(s) for the app's OUTBOUND requests (M3U/EPG fetches, mirror
# directory scrapes, HLS proxy) are NOT configured here — there is no NAMESERVER env. On first
# provision the persisted `settings.nameservers` is seeded with a hardcoded default of
# 8.8.8.8,8.8.4.4 (Google public DNS); edit it on the Settings screen afterwards (Mongo wins; the
# change applies live, no restart). Affects global fetch() only — not MongoDB or the ffmpeg/Chromium
# subprocesses. DNS_LOG_LEVEL (1|2|3) still seeds `settings.dnsLogLevel` on first provision: 1 =
# lifecycle + issues only, 2 = + per-host resolution deduped, 3 = every lookup (shown in the View
# logs drawer, core category).
# ------------------------------------------------------------------------------------------

DNS_LOG_LEVEL=2

# DOCKER_SOCK_ACCESS — may masqueradarr use the Docker socket (Docker Engine API)? This ONE switch
# gates every Docker-dependent feature, now and in future. Values: 0 (default) or 1 ONLY (it doubles
# as the socket proxy's scale; "true"/"false" are rejected by docker compose).
#
#   1 = ON. A restricted docker-sock-proxy is started (compose) / the socket is granted to the app
#       (AIO) and masqueradarr gets Docker Engine API access.
#       !! Docker API access is ROOT-EQUIVALENT on this host. Anything that compromises masqueradarr
#       could start a privileged container. The proxy narrows which endpoints can be called; it is NOT
#       a security boundary. Only enable this on a host where you accept that risk.
#
#   0 = OFF. No Docker socket is mounted or granted anywhere. By leaving this at 0 you acknowledge that
#       Docker-dependent features run in their reduced mode:
#         - Rebel IPTV: channels, guide and the Rebel IPTV pop-up still work, but masqueradarr can NOT
#           update, restart or read logs for it, and new Rebel IPTV images must be force-pulled by hand:
#               docker compose pull rebel-iptv && docker compose up -d rebel-iptv
#           Rebel IPTV stops serving channels once it falls too far behind, so do this regularly.
#         - (each future Docker-dependent feature adds its line here)
#
# DOCKER_SOCK_PATH — host socket path, only if non-standard (e.g. rootless Docker).
# ------------------------------------------------------------------------------------------

DOCKER_SOCK_ACCESS=0
# DOCKER_SOCK_PATH=/var/run/docker.sock

# MongoDB root credentials. Seed the `mongo` service's root user AND drive the app's config
# bootstrap: the app self-provisions config.json in-container on boot (docker/app-entrypoint.sh)
# as mongodb://<user>:<pass>@mongo:27017/masqueradarr?authSource=admin (creds URL-encoded — special
# chars in the password are safe). There is no separate config-init service and no host config
# mount; config.json lives at /app/config/config.json inside the container, regenerated each boot.
# MONGO_HOST_PORT = Host port that maps to mongod's 27017 (override if 27017 is taken).
# MONGO_DATA_PATH = Host directory for persistent MongoDB data (bind-mounted to /data/db).
# ------------------------------------------------------------------------------------------

MONGO_ROOT_USER=masqueradarr
MONGO_ROOT_PASS=changeme
MONGO_HOST_PORT=27017
MONGO_DATA_PATH=/absolute/path/to/masqueradarr-vols/mongo
MONGO_USER_ID=999
MONGO_GROUP_ID=999

# Optional: point the app at an external/remote Mongo instead of the compose `mongo` service.
# Set MONGO_URI to a full connection string (used verbatim — e.g. an Atlas mongodb+srv:// URI),
# or just MONGO_HOST/MONGO_HOST_PORT/MONGO_DB to assemble it from the creds.
# ------------------------------------------------------------------------------------------
# MONGO_PORT=27017
# MONGO_HOST=mongo
# MONGO_DB=masqueradarr
# MONGO_URI=mongodb://MONGO_ROOT_USER:MONGO_ROOT_PASS@MONGO_HOST:MONGO_PORT/MONGO_DB?authSource=admin

# Rebel IPTV (optional companion service) — github.com/rebeliptv/iptv
# Rebel IPTV is closed-source, licensed for personal non-commercial use; it always runs as its own
# UNMODIFIED container. Turn it on by uncommenting COMPOSE_FILE (Windows: also uncomment
# COMPOSE_PATH_SEPARATOR and use ';' between the two files). Updates/restarts from masqueradarr need
# DOCKER_SOCK_ACCESS=1 above; with 0 you force-pull new Rebel images by hand.
# REBEL_IPTV_UI_PORT       = host port for the admin-gated Rebel dashboard pop-up (Settings → Rebel IPTV)
# REBEL_IPTV_UI_PUBLIC_URL = full origin of that pop-up when it sits behind TLS / a reverse proxy
#                            (e.g. https://rebel.example.com) — otherwise http://<this host>:<UI port>
# REBEL_IPTV_IMAGE         = a pinned tag (e.g. rebeliptv/iptv:1.5.4) turns updates into info-only notices
# REBEL_IPTV_TRUSTED_PROXIES / REBEL_IPTV_DATA_PATH = Rebel's X-Forwarded-* trust list / its /app/data
# ------------------------------------------------------------------------------------------

# COMPOSE_FILE=docker-compose.yml:docker-compose.rebel-iptv.yml
# COMPOSE_PATH_SEPARATOR=;
# REBEL_IPTV_UI_PORT=3080
# REBEL_IPTV_UI_PUBLIC_URL=
# REBEL_IPTV_IMAGE=rebeliptv/iptv:latest
# REBEL_IPTV_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# REBEL_IPTV_DATA_PATH=/absolute/path/to/masqueradarr-vols/rebel-iptv
